{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "meetily++",
    "version": "0.5.0",
    "identifier": "com.meetily.ai",
    "build": {
        "frontendDist": "../out",
        "devUrl": "http://localhost:3118",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "title": "meetily++",
                "width": 1100,
                "height": 700,
                "resizable": true,
                "fullscreen": false,
                "decorations": true
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "base-uri": "'self'",
                "connect-src": "'self' ipc: http://ipc.localhost",
                "font-src": "'self' data:",
                "form-action": "'self'",
                "frame-ancestors": "'none'",
                "img-src": "'self' data:",
                "object-src": "'none'",
                "script-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "media-src": "'self' blob: data:"
            },
            "devCsp": {
                "default-src": "'self'",
                "base-uri": "'self'",
                "connect-src": "'self' ipc: http://ipc.localhost http://localhost:3118 ws://localhost:3118",
                "font-src": "'self' data:",
                "form-action": "'self'",
                "frame-ancestors": "'none'",
                "img-src": "'self' data:",
                "object-src": "'none'",
                "script-src": "'self' 'unsafe-eval'",
                "style-src": "'self' 'unsafe-inline'",
                "media-src": "'self' blob: data:"
            },
            "capabilities": [
                "main",
                "dictation-widget"
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb",
            "appimage",
            "msi",
            "nsis",
            "app",
            "dmg"
        ],
        "createUpdaterArtifacts": true,
        "icon": [
            "icons/icon.png",
            "icons/app_icon.icns",
            "icons/app_icon.ico"
        ],
        "resources": [
            "templates/*.json"
        ],
        "externalBin": [
            "binaries/llama-helper",
            "binaries/ffmpeg"
        ],
        "macOS": {
            "entitlements": "entitlements.plist",
            "signingIdentity": "-",
            "hardenedRuntime": true
        },
        "windows": {
            "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1"
        },
        "linux": {
            "deb": {
                "depends": [
                    "libopenblas0"
                ]
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1QTA4ODNDQjgyREQ4NTIKUldSUzJDMjRQSWlndFZLUGtkMER0d0FPUG1GalRmYUtSaXFmN0J1M29TMDNkbTNFNHpjdHJVRTcK",
            "endpoints": [
                "https://github.com/anthonyonazure/meetily-merged/releases/latest/download/latest.json"
            ]
        }
    }
}